{
  "manifest_version": 3,
  "name": "HBuf RPC Inspector",
  "version": "1.3.0",
  "description": "类 Network 面板的 Hbuf RPC 调试工具",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
